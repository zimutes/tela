<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Tela.Controls"
        x:Class="Tela.Views.MainWindow"
        Title="Tela"
        Icon="avares://Tela/Assets/tela.ico"
        Width="960" Height="600" MinWidth="320" MinHeight="180"
        Background="Black"
        FontFamily="{DynamicResource FontSans}"
        Foreground="{DynamicResource Text}"
        FontSize="13"
        DragDrop.AllowDrop="True">

  <Panel Name="Root">

    <!-- O vídeo (a libmpv desenha aqui) -->
    <ctl:VideoView Name="Video" />
    <!-- Sem OpenGL (máquinas virtuais, ambientes remotos): o mesmo vídeo, desenhado por software -->
    <ctl:SoftwareVideoView Name="SoftVideo" IsVisible="False" />

    <!-- Só som, sem imagem: o fundo do tema, uma nota e o título -->
    <Panel Name="AudioView" IsVisible="False" IsHitTestVisible="False">
      <ctl:Backdrop />
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Margin="24">
        <ctl:Glyph Kind="Note" Width="56" Height="56" Foreground="{DynamicResource Accent}" />
        <TextBlock Name="AudioTitle" FontFamily="{DynamicResource FontDisplay}" FontSize="22"
                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560" />
      </StackPanel>
    </Panel>

    <!-- Os gestos em cima do vídeo: clique, duplo clique, roda, arrastar a janela -->
    <Border Name="Surface" Background="Transparent" />

    <!-- ── Ecrã inicial ─────────────────────────────────────────────────────── -->
    <Panel Name="Home">
      <ctl:Backdrop />
      <ScrollViewer Name="HomeScroll" Margin="0,44,0,0" HorizontalScrollBarVisibility="Disabled">
        <Grid Name="HomeGrid" RowDefinitions="*,Auto,Auto,*">
          <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="10" Margin="24,12">
            <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
              <ctl:Glyph Kind="Logo" Width="44" Height="44" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
              <TextBlock Text="TELA" FontFamily="{DynamicResource FontDisplay}" FontWeight="{DynamicResource TitleWeight}"
                         LetterSpacing="{DynamicResource TitleSpacing}" FontSize="42" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{DynamicResource L.Tagline}" FontFamily="{DynamicResource FontDisplay}" FontSize="16"
                       Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center" />
            <StackPanel Name="OpenButtons" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,22,0,0">
              <Button Name="OpenFileButton" Classes="big primary" Content="{DynamicResource LU.OpenFile}" />
              <Button Name="OpenFolderButton" Classes="big" Content="{DynamicResource LU.OpenFolder}" />
            </StackPanel>
            <TextBlock Name="HomeHint" Text="{DynamicResource L.DropHint}" Classes="muted" FontSize="12"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
            <Border Name="MissingBox" Classes="card" IsVisible="False" MaxWidth="560" Margin="0,18,0,0">
              <StackPanel Spacing="6">
                <TextBlock Text="{DynamicResource L.MpvMissingTitle}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Brand}" />
                <SelectableTextBlock Name="MissingText" TextWrapping="Wrap" FontSize="12.5" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Name="ContinuePanel" Grid.Row="2" Spacing="12" Margin="24,30,24,28" HorizontalAlignment="Center" IsVisible="False">
            <TextBlock Text="{DynamicResource LU.ContinueWatching}" Classes="label" />
            <ItemsControl Name="ContinueList">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Panel>

    <!-- ── Controlos (somem durante a reprodução) ──────────────────────────── -->
    <Grid Name="Chrome" RowDefinitions="Auto,*,Auto">
      <Grid.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
        </Transitions>
      </Grid.Transitions>

      <!-- Barra de cima: título e botões da janela (é também a pega para a mover) -->
      <Border Name="TopBar" Height="44" Background="{DynamicResource TopBarBg}">
        <Grid ColumnDefinitions="*,Auto" Margin="14,0,6,0">
          <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center" ClipToBounds="True">
            <ctl:Glyph Name="TopLogo" Kind="Logo" Width="16" Height="16" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
            <TextBlock Name="TitleText" Text="TELA" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TitleFg}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Name="QueueText" FontSize="12" Foreground="{DynamicResource TitleFg}" Opacity="0.6" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button Name="MenuButton" Classes="chrome" ToolTip.Tip="{DynamicResource L.Menu}"><ctl:Glyph Kind="Menu" /></Button>
            <Button Name="MinimizeButton" Classes="chrome" ToolTip.Tip="{DynamicResource L.Minimize}"><ctl:Glyph Kind="Minimize" /></Button>
            <Button Name="MaximizeButton" Classes="chrome" ToolTip.Tip="{DynamicResource L.Maximize}"><ctl:Glyph Name="MaximizeGlyph" Kind="Maximize" /></Button>
            <Button Name="CloseButton" Classes="chrome close" ToolTip.Tip="{DynamicResource L.Close}"><ctl:Glyph Kind="Close" /></Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Barra de baixo: posição e comandos -->
      <Border Name="BottomBar" Grid.Row="2" Classes="bar" Margin="12,0,12,12" Padding="10,4,10,8" MaxWidth="1100">
        <StackPanel Spacing="0">
          <ctl:LevelSlider Name="Seek" IsSeekBar="True" Height="24" WheelStep="5" IsEnabled="False" />
          <Grid ColumnDefinitions="Auto,Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
              <Button Name="PlayButton" Classes="tool play" ToolTip.Tip="{DynamicResource L.PlayTip}"><ctl:Glyph Name="PlayGlyph" Kind="Play" /></Button>
              <Button Name="PrevButton" Classes="tool wide" ToolTip.Tip="{DynamicResource L.PrevTip}"><ctl:Glyph Kind="Prev" /></Button>
              <Button Name="NextButton" Classes="tool wide" ToolTip.Tip="{DynamicResource L.NextTip}"><ctl:Glyph Kind="Next" /></Button>
              <Button Name="MuteButton" Classes="tool" ToolTip.Tip="{DynamicResource L.MuteTip}"><ctl:Glyph Name="VolumeGlyph" Kind="Volume" /></Button>
              <ctl:LevelSlider Name="VolumeSlider" Classes="wide" Width="92" Height="28" Minimum="0" Maximum="150"
                               DefaultValue="100" WheelStep="5" ToolTip.Tip="{DynamicResource L.VolumeTip}" />
            </StackPanel>
            <TextBlock Name="TimeText" Grid.Column="1" Classes="time" Margin="12,0,8,0" VerticalAlignment="Center"
                       Text="0:00 / 0:00" Background="Transparent" Cursor="Hand" ToolTip.Tip="{DynamicResource L.TimeTip}" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
              <Button Name="SpeedButton" Classes="tool text wide" Content="1×" ToolTip.Tip="{DynamicResource L.SpeedTip}" />
              <Button Name="SubsButton" Classes="tool wide" ToolTip.Tip="{DynamicResource L.SubsTip}"><ctl:Glyph Name="SubsGlyph" Kind="Subtitles" /></Button>
              <Button Name="AudioButton" Classes="tool wide" ToolTip.Tip="{DynamicResource L.AudioTip}"><ctl:Glyph Kind="AudioTrack" /></Button>
              <Button Name="PipButton" Classes="tool" ToolTip.Tip="{DynamicResource L.PipTip}"><ctl:Glyph Name="PipGlyph" Kind="Pip" /></Button>
              <Button Name="FullscreenButton" Classes="tool" ToolTip.Tip="{DynamicResource L.FullscreenTip}"><ctl:Glyph Name="FullscreenGlyph" Kind="Fullscreen" /></Button>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Pré-visualização por cima da barra de posição -->
    <Border Name="Preview" Classes="preview" IsVisible="False" IsHitTestVisible="False"
            HorizontalAlignment="Left" VerticalAlignment="Bottom">
      <StackPanel Spacing="5">
        <Border Name="PreviewFrame" Classes="thumb" ClipToBounds="True" Width="208" Height="117">
          <Image Name="PreviewImage" Stretch="Uniform" />
        </Border>
        <TextBlock Name="PreviewChapter" FontSize="11.5" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                   MaxWidth="208" Foreground="{DynamicResource TextDim}" />
        <TextBlock Name="PreviewTime" Classes="time" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Mensagens curtas: volume, velocidade, legendas, avisos -->
    <Border Name="Osd" Classes="osd" IsVisible="False" IsHitTestVisible="False"
            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,56,18,0">
      <StackPanel Spacing="7">
        <TextBlock Name="OsdText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="520" />
        <Panel Name="OsdBar" Height="4" Width="180" HorizontalAlignment="Left" IsVisible="False">
          <Border Background="{DynamicResource SliderTrack}" CornerRadius="2" />
          <Border Name="OsdFill" Background="{DynamicResource Accent}" CornerRadius="2" HorizontalAlignment="Left" />
        </Panel>
      </StackPanel>
    </Border>

    <!-- Toque no vídeo: o ícone de tocar/pausa, a desvanecer -->
    <Border Name="FlashBadge" Classes="flash" IsVisible="False" IsHitTestVisible="False"
            HorizontalAlignment="Center" VerticalAlignment="Center" Width="78" Height="78" CornerRadius="39">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.35" />
        </Transitions>
      </Border.Transitions>
      <ctl:Glyph Name="FlashGlyph" Kind="Play" Width="28" Height="28" Foreground="White" />
    </Border>

    <!-- A seguir (com contagem) ou fim da lista -->
    <Border Name="UpNext" Classes="card" IsVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,24,118" Width="330">
      <StackPanel Spacing="8">
        <TextBlock Name="UpNextLabel" Classes="label" />
        <TextBlock Name="UpNextTitle" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
          <Button Name="UpNextPlay" Classes="primary" />
          <Button Name="UpNextCancel" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Informação técnica (Shift+I) -->
    <Border Name="InfoPanel" Classes="card" IsVisible="False" IsHitTestVisible="False"
            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,56,18,0">
      <TextBlock Name="InfoText" FontFamily="{DynamicResource FontMono}" FontSize="11.5" LineHeight="18" />
    </Border>

    <!-- Janelas por cima (atalhos, acerca) -->
    <Border Name="Overlay" IsVisible="False" Background="#99000000" Padding="22">
      <Border Classes="panel" Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource MenuBorder}"
              VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560" Padding="22">
        <ContentControl Name="OverlayContent" />
      </Border>
    </Border>

    <!-- Bordas para redimensionar (Linux: a janela não tem a moldura do sistema) -->
    <Panel Name="ResizeEdges" IsVisible="False">
      <Border Name="EdgeN" Classes="edge" Height="5" VerticalAlignment="Top" Cursor="TopSide" />
      <Border Name="EdgeS" Classes="edge" Height="5" VerticalAlignment="Bottom" Cursor="BottomSide" />
      <Border Name="EdgeW" Classes="edge" Width="5" HorizontalAlignment="Left" Cursor="LeftSide" />
      <Border Name="EdgeE" Classes="edge" Width="5" HorizontalAlignment="Right" Cursor="RightSide" />
      <Border Name="EdgeNW" Classes="edge" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="TopLeftCorner" />
      <Border Name="EdgeNE" Classes="edge" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="TopRightCorner" />
      <Border Name="EdgeSW" Classes="edge" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="BottomLeftCorner" />
      <Border Name="EdgeSE" Classes="edge" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="BottomRightCorner" />
    </Panel>
  </Panel>
</Window>
